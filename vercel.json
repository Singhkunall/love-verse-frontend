{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/app.apk", "dest": "/app.apk" },
    { "src": "/LoveVerse-v5-Final.apk", "dest": "/LoveVerse-v5-Final.apk" },
    { "src": "/LoveVerse-v4.apk", "dest": "/LoveVerse-v4.apk" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}